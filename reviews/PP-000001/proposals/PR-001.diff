+++ b/iosApp/iosApp/Feed/FeedAgeLabel.swift
@@ -1,6 +1,50 @@
 import Foundation
 import SharedLogic
 
+/// "Today · 10:52 AM" / "Yesterday · 8:05 PM" / "12 Oct · 9:30 AM" — the
+/// date of a post on its card. The day word comes from the system's own
+/// relative formatting, so it reads in the person's language. A date with no
+/// time ("2026-10-12") shows the day alone.
+@MainActor
+func feedDateTimeLabel(_ createdAt: String, locale: LocaleStore) -> String {
+    let lang = Locale(identifier: locale.language)
+    let iso = ISO8601DateFormatter()
+    iso.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+    var date = iso.date(from: createdAt)
+    if date == nil {
+        iso.formatOptions = [.withInternetDateTime]
+        date = iso.date(from: createdAt)
+    }
+    var hasTime = true
+    if date == nil {
+        iso.formatOptions = [.withFullDate]
+        date = iso.date(from: String(createdAt.prefix(10)))
+        hasTime = false
+    }
+    guard let date else { return feedAgeLabel(createdAt, locale: locale) }
+
+    let day = DateFormatter()
+    day.locale = lang
+    day.dateStyle = .medium
+    day.timeStyle = .none
+    day.doesRelativeDateFormatting = true
+    var dayText = day.string(from: date)
+    // Older than yesterday: a short "12 Oct", not the medium "12 Oct 2026".
+    if !Calendar.current.isDateInToday(date) && !Calendar.current.isDateInYesterday(date) {
+        let short = DateFormatter()
+        short.locale = lang
+        let sameYear = Calendar.current.isDate(date, equalTo: Date(), toGranularity: .year)
+        short.setLocalizedDateFormatFromTemplate(sameYear ? "dMMM" : "dMMMy")
+        dayText = short.string(from: date)
+    }
+    guard hasTime else { return dayText }
+    let time = DateFormatter()
+    time.locale = lang
+    time.dateStyle = .none
+    time.timeStyle = .short
+    return "\(dayText) · \(time.string(from: date))"
+}
+
 /// "2h" / "3d" / a short date — the same buckets on every post.
